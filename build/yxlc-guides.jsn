  {
    id: 'yxlc-start', game: 'yxlc', cat: 'start', level: '入门',
    title: '三职业怎么选：铁三角分工与开服节奏',
    dek: '战士、法师、弓箭手的经典铁三角原样回归。选职业只是第一步，开服前三天把挂机与资源节奏安排对，比职业本身更影响进度。',
    take: ['战士扛伤前排、法师范围清怪、弓手远近兼备散人挂机舒服', '删档测试 11.6 19 点开、11.20 18 点关，不删档一区 11.20 19 点接续', '删档期间充值按 120% 返还，限原账号不删档一区第一个角色，开服起 7 天内领', '内置挂机可托管刷怪攒材料，空闲再上线抢 BOSS'],
    blocks: [
      { t: 'h', v: '三职业定位' },
      { t: 'table', w: [16, 44, 40], head: ['职业', '定位与代表内容', '适合谁'], rows: [
        ['战士', '重甲高血高防，袭风刺、雷霆裂闪；攻城与 BOSS 副本的前排支柱', '喜欢稳、愿意顶在前排的玩家'],
        ['法师', '冰火雷元素大范围 AOE，黑龙波、极光清怪效率顶尖；身板脆怕近身', '刷怪打宝冲级，肯走位的人'],
        ['弓箭手', '远程输出兼辅助增益，可召唤宠物协同；散人挂机发育最舒服', '散人、时间碎片化的玩家']
      ] },
      { t: 'p', v: '三个职业平衡不碾压，不存在单职业无敌。这游戏装备靠打宝产出、可自由交易，职业差距会被投入时间抹平一部分——选愿意长期玩的那个。' },
      { t: 'h', v: '开服节点与返利规则' },
      { t: 'table', w: [34, 30, 36], head: ['节点', '时间', '要点'], rows: [
        ['计费删档测试开启', '11 月 6 日 19:00', '充值实测，数据随后清空'],
        ['删档测试结束', '11 月 20 日 18:00', '删档期间充值按总额 120% 返还'],
        ['不删档一区开服', '11 月 20 日 19:00', '返还货币在此领取']
      ] },
      { t: 'ul', v: ['返还必须用充值的原账号', '只能在不删档一区、账号新建的第一个角色上领', '有效期从一区开服起 7 天，逾期没有补领渠道', '返还的货币不参与新服充值活动', '参考：测试期充 100，返还等值 120 的额度货币'] },
      { t: 'note', v: '返利绑定一区第一个角色——想好主号再创建，别随手建了个小号把返还名额占了。' },
      { t: 'h', v: '前三天做什么' },
      { t: 'ul', v: ['主线一路推完，转职流程先走完', '把挂机点位定下来：怪密度、掉落与回城距离三者权衡', '白天托管挂材料攒经验，空闲时段上线蹲黄金怪与世界首领', '野外 BOSS、副本宝箱掉未鉴定装备，自动捡取里单独勾选它，白色低品质设自动丢弃'] },
      { t: 'note', v: '下载认准官方渠道（yxnd328.com），短视频评论区的陌生链接、第三方应用商店的同名游戏多为私服或渠道服，与官服不互通，随时可能关服丢号。' }
    ]
  },
  {
    id: 'yxlc-blood', game: 'yxlc', cat: 'boss', level: '进阶',
    title: '血色城堡组队打法：门票、阵容与守点站位',
    dek: '限时专属副本，门票「透明披风」全靠日常攒，进场即消耗。队伍怎么搭、流程怎么走、收尾怎么守，决定你这一张票是稳赚还是打水漂。',
    take: ['门票透明披风靠日常任务、野外挂机、战盟福利与活动慢慢攒，获取周期不短', '稳妥阵容：1 名前排剑士 + 1~2 名输出 + 1 名精灵辅助', '固定流程：清吊桥 → 破城门 → 杀骷灵巫师 → 碎水晶棺拾大天使武器 → 交付', '收益看经验、宝石材料、卓越装备三个维度，达成两个即算合格'],
    blocks: [
      { t: 'h', v: '副本定位与门票' },
      { t: 'p', v: '血色城堡是限时副本：从进场起倒计时，清怪、破门、击杀目标、交付都要在规定时间内完成，超时判失败，门票白消耗、奖励拿不到全额。副本内怪物密度高、经验加成丰厚，宝石与合成材料掉率明显高于野外，还有概率直接出卓越装备——性价比远高于漫无目的的野外挂机。' },
      { t: 'ul', v: ['透明披风来源：日常任务、野外挂机、战盟福利、活动奖励', '获取周期不短，每一次进场机会都珍贵', '进本前检查背包：披风带了吗、背包格够吗'] },
      { t: 'h', v: '队伍配置' },
      { t: 'ul', v: ['1 名前排剑士：拉仇恨、卡路口、替后排吃伤害', '1~2 名输出（法师、魔剑士）：范围技能清群怪，打城门与水晶棺', '1 名精灵辅助：全队回血、加攻防 buff，压药水消耗', '不推荐全输出队：没有前排扛伤，被围就团灭', '装备底子差别单挑——单人等于同时干扛怪和输出两件事'] },
      { t: 'note', v: '优先在战盟里找固定队友：沟通方便、打法熟悉，长期收益远高于临时野队。' },
      { t: 'h', v: '推进流程' },
      { t: 'table', w: [26, 40, 34], head: ['阶段', '做什么', '注意'], rows: [
        ['进场', '先清入口小怪，全员集合、补满血和 buff', '别有人开局就往前冲'],
        ['推进', '前排把分散的怪牵到窄道、墙角聚成一条线，输出再开 AOE', '站位靠在一起，别让辅助落单'],
        ['破城门', '全员集中打门', '等全队到齐再启动下一段'],
        ['杀骷灵巫师', '按目标逐个击杀', '别提前触发下一波刷新'],
        ['水晶棺', '打碎棺体，拾取大天使武器后交付', '交付完成才算通关']
      ] },
      { t: 'h', v: '守点站位' },
      { t: 'p', v: '标准三层站位：剑士堵通道最前面，输出站侧后方安全输出，精灵辅助再退半步稳定加血。收尾最后一波数量多、强度高——提前把药水补满，范围大招留到怪群刷新时再放。关键位置一倒，防线就崩，前面十几分钟全部作废。' },
      { t: 'h', v: '高频失误清单' },
      { t: 'ul', v: ['排队前没检查透明披风，到场才发现门票不足', '全输出阵容没前排，被围团灭', '打到一半队友离队，人数不足守不住点', '背包没清，卓越装备打出来捡不起来——进场前清包并设好拾取过滤'] },
      { t: 'note', v: '打完从三个维度复盘：经验涨幅、宝石材料收获、有没有卓越装备——达成两个即收益合格。三个都不达，多半是难度选高了，下次降一档；装备没成型就先做主线、转职和武器强化，回头再刷。' }
    ]
  },
  {
    id: 'yxlc-identify', game: 'yxlc', cat: 'money', level: '进阶',
    title: '装备鉴定与野外打宝：词条怎么筛、BOSS 怎么蹲',
    dek: '未鉴定装备全靠概率开出极品，鉴定没有捷径。词条按职业筛、拾取过滤先设好、BOSS 点位分工蹲，打宝的收益差就差在这三件事上。',
    take: ['野外 BOSS、精英怪、副本宝箱掉未鉴定装备，BOSS 掉落的基础品质上限更高', '剑士优先防御/血量/减伤，法师优先魔力/技能伤害/回蓝，弓手按输出或辅助路线选', '自动捡取单独勾选未鉴定装备，白色低品质设自动丢弃', '不合适的良品装备走交易市场流通，换自己需要的资源'],
    blocks: [
      { t: 'h', v: '鉴定机制' },
      { t: 'p', v: '装备鉴定是原版机制：开鉴定前不知道属性，每次都带随机性。鉴定概率纯看脸，没有必出极品的捷径——连续几发结果普通很正常，放平心态，别因为脸黑就放弃打宝。' },
      { t: 'h', v: '词条优先级' },
      { t: 'table', w: [18, 44, 38], head: ['职业', '优先词条', '理由'], rows: [
        ['剑士', '防御、血量、减伤', '前排定位，站得住才有输出空间'],
        ['法师', '魔力、技能伤害、回蓝', 'AOE 清怪耗蓝大，续航即效率'],
        ['弓箭手', '按路线二选一：输出走攻击/攻速，辅助走增益相关', '远近兼备，先定路线再筛词条']
      ] },
      { t: 'p', v: '拿到装备先对照职业筛一遍：词条对路的自己穿，不对路的良品别急着分解或贱卖——交易市场流通是打宝收入的一半，挂个合理价慢慢等。' },
      { t: 'h', v: '拾取与背包' },
      { t: 'ul', v: ['自动捡取单独勾选「未鉴定装备」，优先留存', '白色低品质装备设自动丢弃，省背包格', '蹲 BOSS 前清空背包杂物——打出卓越装备捡不起来是最冤的亏损'] },
      { t: 'h', v: '蹲 BOSS 的分工' },
      { t: 'ul', v: ['野外 BOSS、精英怪掉落的基础品质上限更高，出极品潜力最大', '战盟定期组织蹲点：分工警戒、输出，防止被别的队伍抢', '高阶地图是争夺区域，安排专人观察周边动向，打不过就转移点位', '三端互通：出门手机能上线看收获，回家模拟器继续组队'] },
      { t: 'note', v: '核对客户端版本号与官方公告一致再进游戏，版本老旧会出现装备模型不显示、鉴定面板加载失败的问题。' }
    ]
  },
  {
    id: 'yxlc-line', game: 'yxlc', cat: 'sys', level: '入门',
    title: '连线战斗规则：同色连携与属性克制',
    dek: '进游戏第一场战斗的核心操作不是点技能，而是从主角位置连同色方块。连线长度决定伤害，属性克制决定先连哪一色。',
    take: ['从主角出发连接同色方块，主角沿路径移动并召唤对应颜色英雄攻击', '连线越长伤害越高，连得越多越容易触发连携技能', '一回合内多次点击方块可形成连锁攻击，打出范围伤害', '先判断敌人属性倾向，再决定优先连哪一色'],
    blocks: [
      { t: 'h', v: '基础规则' },
      { t: 'p', v: '战斗界面上连方块：从主角位置出发，连接同色方块，主角沿路径移动，并召唤对应颜色的英雄发动攻击。所以「英雄品质」之外，连线操作本身就是输出的一部分——急着招募高品质英雄之前，先把连线节奏练熟，对前三天的推图效率影响更大。' },
      { t: 'h', v: '连线长度与连锁' },
      { t: 'ul', v: ['连线长度决定伤害，并累积连携消除的方块数量', '连得越多，越容易触发连携技能', '一回合内多次点击方块，可以形成连锁攻击，打出范围伤害', '开荒不求完美，但至少做到「能连四五个就不只连两三个」'] },
      { t: 'h', v: '属性克制' },
      { t: 'p', v: '攻击属性之间存在相互克制关系，这是连线的隐藏维度。面对敌人先判断对方的属性倾向，再决定优先优先连哪一色方块——比看到同色就闷头连更有效。' },
      { t: 'ul', v: ['开服阶段用低强度关卡把连线节奏和克制习惯练成肌肉记忆', '推图卡关时先回头检查连线质量，再考虑换阵容', '连携与连锁叠加使用，一轮里能打出的伤害远高于单点'] },
      { t: 'note', v: '公测及后续版本时间以官方公告为准；玩法若随版本调整，以游戏内实际说明为准。' }
    ]
  },
  {
    id: 'yxlc-wings', game: 'yxlc', cat: 'cls', level: '进阶',
    title: '翅膀合成与养成路线：玛雅宝石怎么用',
    dek: '一代、二代翅膀都能用玛雅宝石和创造宝石合成，翅膀自带流光外观与攻防、伤害吸收加成。强化、追加、镶嵌、套装的顺序排对，平民也能慢慢攒出毕业装。',
    take: ['一代、二代翅膀用玛雅宝石 + 创造宝石合成获取', '翅膀带高额攻防与伤害吸收加成，是养成线的核心目标', '强化、追加、宝石镶嵌、套装收集、幸运属性等经典系统全部保留', '装备不强制绑定、可自由交易，散人靠打宝也能攒出极品套装'],
    blocks: [
      { t: 'h', v: '翅膀怎么合成' },
      { t: 'table', w: [20, 42, 38], head: ['翅膀', '材料', '说明'], rows: [
        ['一代翅膀', '玛雅宝石 + 创造宝石', '合成有失败率，材料分批攒，别一次梭哈'],
        ['二代翅膀', '一代翅膀 + 玛雅宝石 + 创造宝石等', '材料需求更高，先用一代过渡攻防收益']
      ] },
      { t: 'p', v: '翅膀是当年无数玩家的终极追求，加成也实在：外观流光之外，还有高额攻防与伤害吸收。合成材料主要靠打怪掉落与活动产出——宝石、创造、生命等稀缺资源全图都有机会掉，商城不垄断售卖。' },
      { t: 'h', v: '养成顺序' },
      { t: 'table', w: [22, 42, 36], head: ['系统', '做什么', '优先级'], rows: [
        ['强化', '核心武器先稳定强化到能单刷野外怪的水平', '最高：先有输出再谈别的'],
        ['追加', '强化稳定后再追加防具', '中：防御线补齐'],
        ['宝石镶嵌', '按职业词条选宝石（参考鉴定篇）', '中：与追加并行'],
        ['套装收集', '慢慢凑，凑齐的部位优先穿', '长期：毕业装的主线']
      ] },
      { t: 'ul', v: ['装备没有强制绑定，打造路线自由：高攻、高防、高幸运都能走', '不存在的固定模板——按自己想法慢慢打造专属毕业装', '打宝产出自由流通，平民刷出的极品也能换资源'] },
      { t: 'note', v: '升级节奏平缓，没有一天直升几百级的捷径；翅膀是长期目标，前期把强化和挂机收益做稳，材料自然攒得起来。' }
    ]
  }
